{
  "name": "@genix/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "svelte": "./index.ts",
  "types": "./index.ts",
  "files": [
    "*.css",
    "*.d.ts",
    "*.ts",
    "agent",
    "assets",
    "buttons",
    "cache",
    "cards",
    "charts",
    "editor",
    "excel",
    "files",
    "form",
    "http",
    "layers",
    "menu",
    "misc",
    "navigation",
    "runtime",
    "security",
    "service-worker",
    "utilities",
    "vTable",
    "workers"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "svelte": "./index.ts",
      "default": "./index.ts"
    },
    "./runtime": {
      "types": "./runtime/index.ts",
      "svelte": "./runtime/index.ts",
      "default": "./runtime/index.ts"
    },
    "./http": {
      "types": "./http/index.ts",
      "svelte": "./http/index.ts",
      "default": "./http/index.ts"
    },
    "./menu": {
      "types": "./menu/index.ts",
      "svelte": "./menu/index.ts",
      "default": "./menu/index.ts"
    },
    "./editor": {
      "types": "./editor/index.ts",
      "svelte": "./editor/index.ts",
      "default": "./editor/index.ts"
    },
    "./excel": {
      "types": "./excel/index.ts",
      "svelte": "./excel/index.ts",
      "default": "./excel/index.ts"
    },
    "./charts": {
      "types": "./charts/index.ts",
      "svelte": "./charts/index.ts",
      "default": "./charts/index.ts"
    },
    "./cache": {
      "types": "./cache/index.ts",
      "svelte": "./cache/index.ts",
      "default": "./cache/index.ts"
    },
    "./security": {
      "types": "./security/index.ts",
      "svelte": "./security/index.ts",
      "default": "./security/index.ts"
    },
    "./service-worker": {
      "types": "./service-worker/index.ts",
      "svelte": "./service-worker/index.ts",
      "default": "./service-worker/index.ts"
    },
    "./workers/*": {
      "types": "./workers/*.ts",
      "svelte": "./workers/*.ts",
      "default": "./workers/*.ts"
    },
    "./utilities": {
      "types": "./utilities/index.ts",
      "svelte": "./utilities/index.ts",
      "default": "./utilities/index.ts"
    },
    "./*": {
      "types": "./*",
      "svelte": "./*",
      "default": "./*"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.46.0"
  },
  "dependencies": {
    "@ivanjoz/minijson": "github:ivanjoz/minijson#v0.1.0",
    "@humanspeak/svelte-virtual-list": "^0.3.5",
    "@jsquash/avif": "^2.1.1",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.0",
    "dompurify": "^3.4.2",
    "esm-env": "^1.2.2",
    "excelize-wasm": "^0.1.1",
    "leafer-ui": "^2.0.3",
    "normalize-html-whitespace": "^1.0.0",
    "roosterjs": "^9.41.0",
    "svelte-awesome-color-picker": "^4.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/bun": "^1.3.6",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2"
  }
}
