{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true
  },
  "include": [
    "*.d.ts",
    "*.ts",
    "**/*.ts",
    "**/*.svelte"
  ],
  "exclude": [
    ".svelte-kit",
    "dist",
    "node_modules"
  ]
}
